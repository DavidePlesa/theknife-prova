<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="4" styleClass="ristorante-card" fx:controller="theknife.client.RestaurantCardController" stylesheets="@restaurantCard.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets top="14" right="14" bottom="14" left="14" />
    </padding>

    <Label fx:id="nomeLabel" styleClass="card-nome" />
    <Label fx:id="categoriaLabel" styleClass="card-categoria" />
    <Label fx:id="localitaLabel" styleClass="card-localita" />
</VBox>